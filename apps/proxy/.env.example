# HeatPizza provider proxy configuration. Never commit a real key.
# Copy to your environment and set values server-side only.

# seoul (서울시 대중교통환승경로, ws.bus.go.kr pathinfo — Seoul-only, free auto-approved
# data.go.kr key) or odsay (https://www.odsay.com). Rev 7 default: seoul.
TRANSIT_PROVIDER=seoul

# Secret provider API key (server-side only, never in the app bundle).
# seoul: data.go.kr 검색허용서비스 serviceKey (item 15000414), URL-encoded.
# odsay: your ODsay OpenAPI key.
TRANSIT_API_KEY=

# Kakao Local API (v2/local) REST key — powers /api/places (Korean place search).
# Created at developers.kakao.com -> 앱 설정 -> 요약정보 -> 앱 키 (REST API 키).
KAKAO_REST_KEY=

# HTTP port for the proxy
PORT=3001